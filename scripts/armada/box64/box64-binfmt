#!/usr/bin/bash
# Mount binfmt_misc and register box64 as the x86 / x86-64 interpreter.
#
# Why this exists: systemd-binfmt only starts when /proc/sys/fs/binfmt_misc is
# already a mountpoint, and nothing mounts it at boot in this container, so the
# vendor binfmt.d entries silently never get registered. Without this unit an
# x86 binary fails with ENOEXEC ("cannot execute binary file") and Steam reports
# the game process dying a second after launch.
#
# The entries come from /usr/lib/binfmt.d/box64.conf -- the same file the image
# and the RPM ship -- so there is one list, and it covers both machines. This unit
# used to hardcode a single x86-64 entry named `box64`, which left 32-bit guests
# with no handler at all.
#
# Handlers are dropped by *interpreter*, not by name: the table has carried three
# naming schemes (`box64`, `box64-x86_64`/`box64-i386`, `FEX-*`) and a fixed list
# always misses one. binfmt_misc prefers the handler registered last, so re-adding
# box64 last is also what makes it win over a FEX entry still in the table.
set -u

MNT=/proc/sys/fs/binfmt_misc
BOX64=/usr/bin/box64
CONF=/usr/lib/binfmt.d/box64.conf

if [[ ! -x $BOX64 ]]; then
    echo "box64 is not installed" >&2
    exit 1
fi
if [[ ! -r $CONF ]]; then
    echo "missing $CONF" >&2
    exit 1
fi
if ! mountpoint -q "$MNT"; then
    mount -t binfmt_misc binfmt_misc "$MNT" || exit 1
fi

drop_interpreter() {
    local want=$1 entry name interp
    for entry in "$MNT"/*; do
        name=${entry##*/}
        case $name in register|status) continue ;; esac
        [[ -f $entry ]] || continue
        interp=$(sed -n 's/^interpreter //p' "$entry" 2>/dev/null | head -1)
        [[ $interp == "$want" ]] || continue
        echo -1 > "$entry" 2>/dev/null || true
    done
    return 0
}
drop_interpreter "$BOX64"
drop_interpreter /usr/bin/FEX
drop_interpreter /usr/local/bin/FEX

# printf, not echo: the file holds literal \xHH escapes the kernel parses itself.
while IFS= read -r line; do
    [[ -n $line && $line != '#'* ]] || continue
    printf '%s' "$line" > "$MNT/register" || exit 1
done < "$CONF"

if [[ ! -e $MNT/box64-x86_64 ]]; then
    echo "failed to register the box64 binfmt handler" >&2
    exit 1
fi

exit 0
