[Unit]
Description=Register the x86-64 emulator (box64) with binfmt_misc
Documentation=file:/usr/share/doc/armada/box64.md
# Nothing in the early boot sequence needs this, but every x86-64 game does, so
# bring it up with the session infrastructure instead of on first use.
After=local-fs.target
Before=systemd-user-sessions.service graphical.target
ConditionPathExists=/usr/bin/box64

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/armada/box64-binfmt
ExecStop=/bin/sh -c '[ -e /proc/sys/fs/binfmt_misc/box64 ] && echo -1 > /proc/sys/fs/binfmt_misc/box64; exit 0'

[Install]
WantedBy=multi-user.target