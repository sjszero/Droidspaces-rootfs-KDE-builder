+// One CPU performance domain of the kernel energy model.
+//
+// The kernel publishes a static power table for every OPP under
+// /sys/kernel/debug/energy_model/<domain>/ps:<freq>/power (microwatts) and the
+// per-frequency residency counters under
+// /sys/devices/system/cpu/cpuN/cpufreq/stats/time_in_state (milliseconds).
+struct CPUPowerData_energy_model_domain {
+   int first_cpu = -1;
+   std::string time_in_state_path;
+   // frequency (kHz) -> power (uW), sorted ascending by frequency
+   std::vector<std::pair<uint64_t, uint64_t>> table;
+   // residency snapshot taken on the previous sample
+   std::vector<std::pair<uint64_t, uint64_t>> last_residency;
+   bool has_last = false;
+};
+
+struct CPUPowerData_energy_model : public CPUPowerData {
+   CPUPowerData_energy_model() {
+      this->source = CPU_POWER_ENERGY_MODEL;
+   };
+   std::vector<CPUPowerData_energy_model_domain> domains;
+};
 
