+// Read the per-frequency residency counters of a cpufreq policy.
+// Returns false when the file is unreadable or contains no usable rows.
+static bool read_time_in_state(const std::string& path,
+                               std::vector<std::pair<uint64_t, uint64_t>>& out) {
+    std::ifstream file(path);
+    if (file.fail())
+        return false;
+    out.clear();
+    for (std::string line; std::getline(file, line); ) {
+        if (line.empty())
+            continue;
+        std::istringstream iss(line);
+        uint64_t freq = 0;
+        uint64_t time = 0;
+        if (!(iss >> freq >> time))
+            continue;
+        out.emplace_back(freq, time);
+    }
+    return !out.empty();
+}
+
+// Residency-weighted CPU power estimate driven by the kernel energy model.
+//
+// The residency deltas of the sampling window are weighted by the power table, so
+// the result is the average power over that window rather than an instantaneous
+// guess. Using deltas instead of the absolute counters keeps the value meaningful
+// even though they accumulate since boot.
+static bool get_cpu_power_energy_model(CPUPowerData* cpuPowerData, float& power) {
+    auto* data = static_cast<CPUPowerData_energy_model*>(cpuPowerData);
+    if (!data || data->domains.empty())
+        return false;
+
+    double total_power_uw = 0.0;
+    bool any_domain = false;
+
+    for (auto& domain : data->domains) {
+        std::vector<std::pair<uint64_t, uint64_t>> residency;
+        if (!read_time_in_state(domain.time_in_state_path, residency))
+            continue;
+
+        if (!domain.has_last) {
+            domain.last_residency = residency;
+            domain.has_last = true;
+            continue;
+        }
+
+        uint64_t total_delta = 0;
+        double weighted_power = 0.0;
+        for (size_t i = 0; i < residency.size() && i < domain.last_residency.size(); i++) {
+            const uint64_t freq = residency[i].first;
+            const uint64_t cur = residency[i].second;
+            const uint64_t prev = domain.last_residency[i].second;
+            if (cur <= prev)
+                continue;
+            const uint64_t delta = cur - prev;
+            total_delta += delta;
+
+            // Nearest-OPP lookup: time_in_state and the energy model share the
+            // same frequency set on Qualcomm targets, but tolerate a mismatch
+            // instead of dropping the sample.
+            uint64_t uw = 0;
+            uint64_t best_diff = UINT64_MAX;
+            for (const auto& opp : domain.table) {
+                const uint64_t diff = opp.first > freq ? opp.first - freq : freq - opp.first;
+                if (diff < best_diff) {
+                    best_diff = diff;
+                    uw = opp.second;
+                }
+            }
+            weighted_power += static_cast<double>(delta) * static_cast<double>(uw);
+        }
+
+        domain.last_residency = residency;
+
+        if (total_delta == 0)
+            continue;
+
+        any_domain = true;
+        total_power_uw += weighted_power / static_cast<double>(total_delta);
+    }
+
+    if (!any_domain)
+        return false;
+
+    // The debugfs `power` attribute prints em_perf_state.power * 1000, i.e.
+    // microwatts, so summing microwatts and dividing by 1e6 yields watts.
+    power = static_cast<float>(total_power_uw / 1000000.0);
+    return true;
+}
