+// Parse a CPU list such as "0-1" or "2,4" and return the first CPU number.
+static int parse_first_cpu(const std::string& list) {
+    size_t i = 0;
+    while (i < list.size()) {
+        while (i < list.size() && (list[i] == ',' || list[i] == ' '))
+            i++;
+        if (i >= list.size())
+            return -1;
+
+        int value = 0;
+        bool any = false;
+        while (i < list.size() && list[i] >= '0' && list[i] <= '9') {
+            value = value * 10 + (list[i] - '0');
+            i++;
+            any = true;
+        }
+        if (!any)
+            return -1;
+        // A range such as "0-3" only needs its first member here.
+        if (i < list.size() && list[i] == '-') {
+            i++;
+            while (i < list.size() && list[i] >= '0' && list[i] <= '9')
+                i++;
+        }
+        return value;
+    }
+    return -1;
+}
+
+// Build the energy-model power source from the kernel EAS tables.
+// Returns nullptr when the kernel publishes no usable model.
+static CPUPowerData_energy_model* init_cpu_power_data_energy_model() {
+    const std::string root = "/sys/kernel/debug/energy_model";
+    if (!dir_exists(root))
+        return nullptr;
+
+    auto powerData = std::make_unique<CPUPowerData_energy_model>();
+    for (auto& domain : ls(root.c_str())) {
+        const std::string path = root + "/" + domain;
+        const int first_cpu = parse_first_cpu(read_line(path + "/cpus"));
+        if (first_cpu < 0)
+            continue;
+
+        const std::string time_in_state = "/sys/devices/system/cpu/cpu" +
+            std::to_string(first_cpu) + "/cpufreq/stats/time_in_state";
+        if (!file_exists(time_in_state)) {
+            SPDLOG_DEBUG("energy_model: {} has no time_in_state, skipping", domain);
+            continue;
+        }
+
+        CPUPowerData_energy_model_domain entry;
+        entry.first_cpu = first_cpu;
+        entry.time_in_state_path = time_in_state;
+
+        for (auto& ps : ls(path.c_str(), "ps:", LS_DIRS)) {
+            const std::string freq_str = read_line(path + "/" + ps + "/frequency");
+            const std::string power_str = read_line(path + "/" + ps + "/power");
+            if (freq_str.empty() || power_str.empty())
+                continue;
+            try {
+                const uint64_t freq = std::stoull(freq_str);
+                const uint64_t uw = std::stoull(power_str);
+                if (freq == 0)
+                    continue;
+                entry.table.emplace_back(freq, uw);
+            } catch (const std::exception&) {
+                continue;
+            }
+        }
+
+        if (entry.table.empty()) {
+            SPDLOG_DEBUG("energy_model: {} has no power table, skipping", domain);
+            continue;
+        }
+
+        std::sort(entry.table.begin(), entry.table.end(),
+                  [](const auto& a, const auto& b) { return a.first < b.first; });
+
+        SPDLOG_DEBUG("energy_model: domain {} (cpu{}) with {} OPPs",
+                     domain, first_cpu, entry.table.size());
+        powerData->domains.push_back(std::move(entry));
+    }
+
+    if (powerData->domains.empty()) {
+        SPDLOG_DEBUG("energy_model: no usable performance domains found");
+        return nullptr;
+    }
+    return powerData.release();
+}
