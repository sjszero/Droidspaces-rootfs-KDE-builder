+void SignalDelegator::ResumeWithGuestGPRs(ArchHelpers::Context::ContextBackup* Context, FEXCore::Core::CpuStateFrame* Frame, void* ucontext,
+                                          const uint64_t* GuestGPRs, size_t Count, uint64_t Mask) {
+#ifdef ARCHITECTURE_arm64
+  const uint32_t Spilled = Context->InSyscallInfo & 0xFFFF;
+  const bool AllSpilled = Spilled == 0xFFFF;
+  if (!AllSpilled && !(Context->Flags & ArchHelpers::Context::ContextFlags::CONTEXT_FLAG_INJIT)) {
+    return;
+  }
+
+  for (size_t i = 0; i < Count && i < Config.SRAGPRCount; i++) {
+    const uint8_t HostReg = Config.SRAGPRMapping[i];
+    const bool InFrame = AllSpilled || (Spilled & (1U << HostReg));
+    const uint64_t Delivered = InFrame ? Frame->State.gregs[i] : ArchHelpers::Context::GetArmReg(ucontext, HostReg);
+    if (((Delivered ^ GuestGPRs[i]) & Mask) == 0) {
+      continue;
+    }
+
+    if (InFrame) {
+      Frame->State.gregs[i] = GuestGPRs[i];
+    } else {
+      ArchHelpers::Context::SetArmReg(ucontext, HostReg, GuestGPRs[i]);
+    }
+  }
+#endif
+}
