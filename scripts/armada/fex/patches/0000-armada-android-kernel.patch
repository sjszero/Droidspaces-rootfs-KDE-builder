+  bool GuestLeftFrame(const ArchHelpers::Context::ContextBackup* Backup, uint64_t GuestSP, uint32_t Limit) {
+    const bool SPOnAlt = OnGuestAltStack(Backup, GuestSP);
+    if (SPOnAlt == OnGuestAltStack(Backup, Backup->GuestFrameEnd)) {
+      return GuestSP >= Backup->GuestFrameEnd;
+    }
+    if (SPOnAlt) {
+      return false;
+    }
+    auto Entry = Backup;
+    while (OnGuestAltStack(Backup, Entry->GuestInterruptedSP)) {
+      if (--Limit == 0 || !Entry->PrevGuestFrame) {
+        return false;
+      }
+      Entry = reinterpret_cast<const ArchHelpers::Context::ContextBackup*>(Entry->PrevGuestFrame);
+    }
+    return OnGuestAltStack(Backup, Entry->GuestFrameEnd) && Entry->GuestAltBase == Backup->GuestAltBase &&
+           Entry->GuestAltEnd == Backup->GuestAltEnd && GuestSP >= Entry->GuestInterruptedSP;
+  }
