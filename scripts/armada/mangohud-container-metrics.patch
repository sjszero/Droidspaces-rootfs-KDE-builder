+// Android/Qualcomm EAS energy model support.
+// The kernel exposes a static power table per CPU performance domain under
+// /sys/kernel/debug/energy_model/<domain>/ps:<freq>/power (milliwatts), and the
+// per-frequency residency counters under
+// /sys/devices/system/cpu/cpuN/cpufreq/stats/time_in_state (milliseconds).
+// Power is the residency-weighted average of the table, which is exactly the
+// model the Android power HAL uses. No hardware energy counter is required.
+struct CPUPowerData_energy_model_domain {
+   int first_cpu = -1;
+   std::string time_in_state_path;
+   // frequency (kHz) -> power (mW), sorted ascending by frequency
+   std::vector<std::pair<uint64_t, uint64_t>> table;
+   // residency snapshot from the previous sample
+   std::vector<std::pair<uint64_t, uint64_t>> last_residency;
+   Clock::time_point lastSampleTime = Clock::now();
+   bool has_last = false;
+};
+
+struct CPUPowerData_energy_model : public CPUPowerData {
+   CPUPowerData_energy_model() {
+      this->source = CPU_POWER_ENERGY_MODEL;
+   };
+   std::vector<CPUPowerData_energy_model_domain> domains;
+};
 
