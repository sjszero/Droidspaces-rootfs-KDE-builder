+// Read the per-frequency residency counters of a cpufreq policy.
+// Returns false if the file is unreadable or empty.
+static bool read_time_in_state(const std::string& path,
+                               std::vector<std::pair<uint64_t, uint64_t>>& out) {
+    std::ifstream file(path);
+    if (file.fail())
+        return false;
+    out.clear();
+    std::string line;
+    while (std::getline(file, line)) {
+        if (line.empty())
+            continue;
+        std::istringstream iss(line);
+        uint64_t freq = 0;
+        uint64_t time = 0;
+        if (!(iss >> freq >> time))
+            continue;
+        out.emplace_back(freq, time);
+    }
+    return !out.empty();
+}
+
+// Residency-weighted CPU power estimate driven by the kernel EAS energy model.
+//
+// The kernel publishes a vendor-calibrated power table (mW) for every OPP of
+// each CPU performance domain. Combining that static table with the per-OPP
+// residency deltas gives the average power over the sampling window. This is
+// the same model the Android power HAL uses, and it needs no hardware energy
+// counter, which is why it works on devices that expose neither hwmon nor
+// powercap.
+static bool get_cpu_power_energy_model(CPUPowerData* cpuPowerData, float& power) {
+    CPUPowerData_energy_model* data = (CPUPowerData_energy_model*)cpuPowerData;
+    if (!data || data->domains.empty())
+        return false;
+
+    Clock::time_point now = Clock::now();
+    double total_power_uw = 0.0;
+    bool any_domain = false;
+
+    for (auto& domain : data->domains) {
+        std::vector<std::pair<uint64_t, uint64_t>> residency;
+        if (!read_time_in_state(domain.time_in_state_path, residency))
+            continue;
+
+        if (!domain.has_last) {
+            domain.last_residency = residency;
+            domain.lastSampleTime = now;
+            domain.has_last = true;
+            continue;
+        }
+
+        // Sum the residency deltas over the sampling window. Using deltas
+        // rather than the absolute counters keeps the estimate meaningful even
+        // though the counters accumulate since boot.
+        uint64_t total_delta = 0;
+        double weighted_power = 0.0;
+        for (size_t i = 0; i < residency.size() && i < domain.last_residency.size(); i++) {
+            uint64_t freq = residency[i].first;
+            uint64_t cur = residency[i].second;
+            uint64_t prev = domain.last_residency[i].second;
+            if (cur <= prev)
+                continue;
+            uint64_t delta = cur - prev;
+            total_delta += delta;
+
+            // Nearest OPP lookup: time_in_state and the energy model share the
+            // same frequency set on Qualcomm targets, but tolerate a mismatch
+            // instead of dropping the sample.
+            uint64_t uw = 0;
+            bool found = false;
+            for (const auto& entry : domain.table) {
+                if (entry.first == freq) {
+                    uw = entry.second;
+                    found = true;
+                    break;
+                }
+            }
+            if (!found) {
+                uint64_t best_diff = UINT64_MAX;
+                for (const auto& entry : domain.table) {
+                    uint64_t diff = entry.first > freq ? entry.first - freq : freq - entry.first;
+                    if (diff < best_diff) {
+                        best_diff = diff;
+                        uw = entry.second;
+                    }
+                }
+            }
+            weighted_power += (double)delta * (double)uw;
+        }
+
+        domain.last_residency = residency;
+        domain.lastSampleTime = now;
+
+        if (total_delta == 0)
+            continue;
+
+        any_domain = true;
+        total_power_uw += weighted_power / (double)total_delta;
+    }
+
+    if (!any_domain)
+        return false;
+
+    // The debugfs `power` attribute is printed by em_debug_power_show() as
+    // `ps->power * 1000`, i.e. microwatts, even though the in-kernel
+    // em_perf_state.power field is milliwatts. Summing microwatts and dividing
+    // by 1e6 therefore yields watts.
+    power = (float)(total_power_uw / 1000000.0);
+    return true;
+}
