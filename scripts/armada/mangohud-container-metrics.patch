+void GPU_fdinfo::init_thermal_zone_fallback() {
+    thermal_zone_tried = true;
+
+    // Droidspaces containers do not mount /sys/class/hwmon, so the msm driver's
+    // hwmon node is unreachable even though the GPU is real. The kernel still
+    // publishes the same junction temperature as a thermal zone; on Qualcomm
+    // platforms the GPU cluster is `gpuss-N` (older SoCs use `gpu-0-0-0`).
+    // Pick the first matching zone once, then reuse the stream.
+    static const char* prefixes[] = { "gpuss", "gpu-", "gpu_" };
+
+    std::error_code ec;
+    for (const char* prefix : prefixes) {
+        for (fs::directory_iterator it("/sys/class/thermal", ec), end;
+             !ec && it != end; it.increment(ec)) {
+            const std::string dir = it->path().string();
+            const std::string type_path = dir + "/type";
+            std::ifstream type_stream(type_path);
+            if (!type_stream.is_open())
+                continue;
+            std::string type;
+            std::getline(type_stream, type);
+            if (type.rfind(prefix, 0) != 0)
+                continue;
+
+            const std::string temp_path = dir + "/temp";
+            if (!fs::exists(temp_path))
+                continue;
+
+            thermal_zone_stream.open(temp_path);
+            if (thermal_zone_stream.is_open()) {
+                SPDLOG_DEBUG("thermal: using GPU zone {} ({})", dir, type);
+                return;
+            }
+        }
+        if (ec)
+            return;
+    }
+
+    SPDLOG_DEBUG("thermal: no GPU thermal zone available");
+}
+
+float GPU_fdinfo::get_thermal_zone_temp() {
+    if (!thermal_zone_tried)
+        init_thermal_zone_fallback();
+
+    if (!thermal_zone_stream.is_open())
+        return 0.f;
+
+    std::string temp_str;
+    thermal_zone_stream.seekg(0);
+    std::getline(thermal_zone_stream, temp_str);
+    if (temp_str.empty())
+        return 0.f;
+
+    // thermal_zone*/temp is millidegrees Celsius, same unit as hwmon temp*_input.
+    return std::round(std::stof(temp_str) / 1'000.f);
 }
 
